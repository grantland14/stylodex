# Shared with Apart Style; Stylodex uses only the `stylodex` schema (lib/data.ts).
# Server-side only: never reference these from a client component, or the
# project URL ends up in the page and links the two sites.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only, used by /go/ to log clicks.
SUPABASE_SERVICE_ROLE_KEY=

# Skimlinks site ID from the Skimlinks Hub (format like 123456X1234567).
# Leave blank until Skimlinks approves the site; /go/ then redirects without wrapping.
SKIMLINKS_SITE_ID=

# Local development only: serve placeholder data from lib/fixtures.ts.
# Fixture mode forces noindex site-wide and an empty sitemap.
STYLODEX_FIXTURES=

NEXT_PUBLIC_SITE_URL=https://www.stylodex.com
