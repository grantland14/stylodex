---
import "@fontsource/schibsted-grotesk/400.css";
import "@fontsource/schibsted-grotesk/500.css";
import "@fontsource/newsreader/400.css";
import "../styles/global.css";
import { PREVIEW_ONLY } from "@/lib/data";

interface Props {
  title?: string;
  description: string;
  /** Path only, e.g. /brands-like-levis. Omit on pages that shouldn't declare one (404). */
  canonical?: string;
  index?: boolean;
  jsonLd?: object;
}

const { title, description, canonical, index = true, jsonLd } = Astro.props;
const fullTitle = title ? `${title} | Stylodex` : "Stylodex";
// Fixture data must never be indexed.
const robots = index && !PREVIEW_ONLY ? "index, follow" : "noindex, follow";
// "<" escaped so stored text can never close the script tag.
const ld = jsonLd && JSON.stringify(jsonLd).replace(/</g, "\\u003c");
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {canonical && <link rel="canonical" href={new URL(canonical, Astro.site).href} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {ld && <script is:inline type="application/ld+json" set:html={ld} />}
  </head>
  <body class="min-h-screen">
    <div class="h-1 bg-accent" aria-hidden="true"></div>
    <header class="border-b border-rule">
      <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4">
        <a href="/" class="text-sm font-medium tracking-[0.3em] text-ink no-underline">•STYLODEX</a>
        <a href="/how-we-pick" class="text-sm text-ink no-underline hover:underline">How we pick</a>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="mt-24 border-t border-rule">
      <div class="mx-auto flex max-w-6xl flex-wrap gap-x-8 gap-y-3 px-4 py-8 text-sm text-muted">
        <span>© {year} Stylodex</span>
        <a href="/how-we-pick">How we pick</a>
        <a href="/disclosure">Affiliate disclosure</a>
      </div>
    </footer>
  </body>
</html>
