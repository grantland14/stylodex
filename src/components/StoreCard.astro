---
// A brand as a big rounded card: one large photo with the name on it and two smaller product
// photos with their prices. The whole card opens the brand's page; nothing here leaves the site.
import { money, priceSpan } from "@/lib/format";
import type { Brand, ProductShot } from "@/lib/types";

interface Props {
  brand: Brand;
  cover: string;
  shots: ProductShot[];
}

const { brand, cover, shots } = Astro.props;
const prices = priceSpan(brand.prices);
---

<li class="w-64 shrink-0 snap-start sm:w-72">
  <a href={`/brands/${brand.slug}`} class="group relative block aspect-[3/4] overflow-hidden rounded-3xl bg-soft no-underline">
    <img
      src={cover}
      alt=""
      width="600"
      height="800"
      loading="lazy"
      class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
    />
    <span class="absolute inset-0 bg-linear-to-b from-black/5 via-black/35 to-black/60"></span>
    <span class="absolute inset-x-0 top-[36%] px-4 text-center [text-shadow:0_1px_8px_rgba(0,0,0,0.45)]">
      <span class="block text-2xl font-bold tracking-[-0.02em] text-white">{brand.name}</span>
      {prices && <span class="mt-1 block text-sm font-medium text-white">{prices}</span>}
    </span>
    <span class="absolute inset-x-0 bottom-0 grid grid-cols-2 gap-2 p-3">
      {
        shots.map((s) => (
          <span class="relative block aspect-square overflow-hidden rounded-2xl bg-paper">
            <img src={s.imageUrl} alt={s.title} width="300" height="300" loading="lazy" class="h-full w-full object-cover" />
            <span class="absolute left-2 top-2 rounded-full bg-black/65 px-2 py-0.5 text-[11px] font-medium text-white">
              {money(s.price, s.currency)}
            </span>
          </span>
        ))
      }
    </span>
  </a>
</li>
