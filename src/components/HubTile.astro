---
// A home page tile for a category or size hub: its name, brand count and a few brand photos.
import type { Hub } from "@/lib/categories";

interface Props {
  hub: Hub;
  photos: string[];
}

const { hub, photos } = Astro.props;
---

<li>
  <a href={hub.path} class="group flex h-full flex-col bg-soft p-3 no-underline transition-colors hover:bg-rule">
    <div class="grid grid-cols-3 gap-1">
      {photos.map((src) => <img src={src} alt="" width="200" height="250" loading="lazy" class="aspect-[4/5] w-full bg-paper object-cover" />)}
    </div>
    <p class="mt-3 flex items-center justify-between font-medium text-ink">
      <span class="group-hover:underline">{hub.name}</span>
      <span aria-hidden="true">→</span>
    </p>
    <p class="text-sm text-muted">{hub.brands.length} brands</p>
  </a>
</li>
