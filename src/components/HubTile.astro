---
// A home page tile for a category or size hub: one big rounded photo with the name on it.
import type { Hub } from "@/lib/categories";

interface Props {
  hub: Hub;
  photo: string | null;
}

const { hub, photo } = Astro.props;
---

<li>
  <a href={hub.path} class="group relative block aspect-square overflow-hidden rounded-2xl bg-soft no-underline">
    {
      photo && (
        <img
          src={photo}
          alt=""
          width="400"
          height="400"
          loading="lazy"
          class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
        />
      )
    }
    <span class="absolute inset-x-0 bottom-0 bg-linear-to-t from-black/70 to-transparent px-3 pb-3 pt-10">
      <span class="block font-semibold leading-tight text-white">{hub.name}</span>
      <span class="block text-xs text-white/80">{hub.brands.length} brands</span>
    </span>
  </a>
</li>
