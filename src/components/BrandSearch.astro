---
// Brand search with suggestions. Without JavaScript the form opens the A–Z page; with it,
// suggestions come from /search.json (built with the site, so no database calls).
interface Props {
  placeholder?: string;
}
const { placeholder = "Search a brand or store you love" } = Astro.props;
---

<form action="/brands" role="search" class="brand-search relative" data-brand-search>
  <label for="brand-search-input" class="sr-only">Search brands and stores</label>
  <div class="flex items-center border-2 border-ink bg-paper focus-within:border-accent">
    <svg aria-hidden="true" class="ml-4 shrink-0 text-muted" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8">
      <circle cx="8.5" cy="8.5" r="6"></circle>
      <path d="m13 13 5 5"></path>
    </svg>
    <input
      id="brand-search-input"
      name="q"
      type="search"
      autocomplete="off"
      role="combobox"
      aria-expanded="false"
      aria-controls="brand-search-results"
      aria-autocomplete="list"
      placeholder={placeholder}
      class="w-full bg-transparent px-3 py-4 text-base text-ink outline-none placeholder:text-muted"
    />
    <button type="submit" class="btn-solid m-1.5 shrink-0 px-5 py-2.5">Search</button>
  </div>
  <ul
    id="brand-search-results"
    role="listbox"
    hidden
    class="absolute left-0 right-0 z-10 mt-1 max-h-80 overflow-auto border border-rule bg-paper text-left shadow-lg"
  >
  </ul>
</form>

<script>
  interface Entry {
    name: string;
    href: string;
    label: string;
  }

  const norm = (s: string) => s.toLowerCase().normalize("NFKD").replace(/[^a-z0-9]/g, "");

  for (const form of document.querySelectorAll<HTMLFormElement>("[data-brand-search]")) {
    const input = form.querySelector("input")!;
    const list = form.querySelector<HTMLUListElement>("[role=listbox]")!;
    let entries: Entry[] | null = null;
    let matches: Entry[] = [];
    let active = -1;

    const load = async () => {
      if (entries) return entries;
      try {
        entries = (await (await fetch("/search.json")).json()) as Entry[];
      } catch {
        entries = [];
      }
      return entries;
    };

    const close = () => {
      list.hidden = true;
      input.setAttribute("aria-expanded", "false");
      input.removeAttribute("aria-activedescendant");
      active = -1;
    };

    const render = () => {
      list.replaceChildren();
      const q = input.value.trim();
      if (!q) return close();
      if (matches.length === 0) {
        const li = document.createElement("li");
        li.className = "px-4 py-3 text-sm text-muted";
        const a = document.createElement("a");
        a.href = "/brands";
        a.className = "text-link";
        a.textContent = "browse all brands";
        li.append(`No list for “${q}” yet. Try another name or `, a, ".");
        list.append(li);
      }
      matches.forEach((m, i) => {
        const li = document.createElement("li");
        li.id = `brand-search-option-${i}`;
        li.setAttribute("role", "option");
        li.setAttribute("aria-selected", String(i === active));
        li.className = `flex cursor-pointer items-center justify-between px-4 py-3 text-sm ${i === active ? "bg-soft" : ""}`;
        const name = document.createElement("span");
        name.className = "text-ink";
        name.textContent = m.name;
        const label = document.createElement("span");
        label.className = "text-xs text-muted";
        label.textContent = m.label;
        li.append(name, label);
        li.addEventListener("mousedown", (e) => {
          e.preventDefault();
          location.href = m.href;
        });
        list.append(li);
      });
      list.hidden = false;
      input.setAttribute("aria-expanded", "true");
      if (active >= 0) input.setAttribute("aria-activedescendant", `brand-search-option-${active}`);
    };

    input.addEventListener("focus", () => void load());
    input.addEventListener("input", async () => {
      const all = await load();
      const q = norm(input.value);
      const starts = all.filter((e) => norm(e.name).startsWith(q));
      const contains = all.filter((e) => !norm(e.name).startsWith(q) && norm(e.name).includes(q));
      matches = q ? [...starts, ...contains].slice(0, 8) : [];
      active = -1;
      render();
    });
    input.addEventListener("keydown", (e) => {
      if (list.hidden || matches.length === 0) return;
      if (e.key === "ArrowDown" || e.key === "ArrowUp") {
        e.preventDefault();
        active = (active + (e.key === "ArrowDown" ? 1 : -1) + matches.length) % matches.length;
        render();
      } else if (e.key === "Escape") {
        close();
      }
    });
    input.addEventListener("blur", () => setTimeout(close, 100));
    form.addEventListener("submit", (e) => {
      const pick = matches[active] ?? matches[0];
      if (pick) {
        e.preventDefault();
        location.href = pick.href;
      }
    });
  }
</script>
