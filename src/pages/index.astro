---
import BrandSearch from "../components/BrandSearch.astro";
import HubTile from "../components/HubTile.astro";
import Base from "../layouts/Base.astro";
import { categoryHubs, fitHubs, productPhoto, type Hub } from "@/lib/categories";
import { loadCatalog } from "@/lib/catalog";

const { lists, brands } = await loadCatalog();
const groups = categoryHubs(brands);
const fits = fitHubs(brands);
// Quick starts: the biggest categories, then the fits.
const quick = [
  ...groups
    .flatMap((g) => g.hubs)
    .sort((a, b) => b.brands.length - a.brands.length)
    .slice(0, 6),
  ...fits,
];
// Three product photos per tile, so each category shows what's in it (site images are often logos).
const tilePhotos = (hub: Hub) =>
  hub.brands
    .map((b) => productPhoto(b, hub.category))
    .filter((p): p is string => !!p)
    .slice(0, 3);
// The brand wall: the brands people search for (those with a list), biggest lists first.
const bySlug = new Map(brands.map((b) => [b.slug, b]));
const wall = [...lists]
  .sort((a, b) => b.picks - a.picks)
  .flatMap((l) => {
    const brand = bySlug.get(l.anchorSlug);
    const photo = brand && productPhoto(brand);
    return brand && photo ? [{ brand, photo }] : [];
  })
  .slice(0, 12);
---

<Base
  description="Find brands like the ones you already love. Browse fashion brands and stores by category and size, with real prices, sizes and shipping for each."
  canonical="/"
>
  <section class="mx-auto max-w-3xl px-4 pb-12 pt-14 text-center md:pt-20">
    <h1 class="text-4xl font-normal leading-[1.1] tracking-tight md:text-6xl">Find brands like the ones you already love</h1>
    <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-muted">
      Search a brand or store, or browse by what you shop for. Real prices, sizes and shipping for each one.
    </p>
    <div class="mx-auto mt-8 max-w-2xl">
      <BrandSearch placeholder="Search a brand, store or category" />
    </div>
    {
      quick.length > 0 && (
        <ul class="mt-6 flex flex-wrap justify-center gap-2">
          {quick.map((h, i) => (
            <li>
              <a href={h.path} class:list={["chip no-underline hover:underline", ["bg-butter", "bg-mint", "bg-sky", "bg-rose"][i % 4]]}>
                {h.name}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  {
    groups.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 py-10">
        <h2 class="font-serif text-3xl">Shop by category</h2>
        {groups.map((group) => (
          <div class="mt-8">
            <h3 class="eyebrow">{group.name}</h3>
            <ul class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
              {group.hubs.map((hub) => <HubTile hub={hub} photos={tilePhotos(hub)} />)}
            </ul>
          </div>
        ))}
      </section>
    )
  }

  {
    fits.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 py-10">
        <h2 class="font-serif text-3xl">Shop by size</h2>
        <ul class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
          {fits.map((hub) => <HubTile hub={hub} photos={tilePhotos(hub)} />)}
        </ul>
      </section>
    )
  }

  {
    wall.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 py-10">
        <div class="flex items-baseline justify-between gap-4">
          <h2 class="font-serif text-3xl">Brands</h2>
          <a href="/brands" class="text-link text-sm">
            All {brands.length} brands
          </a>
        </div>
        <ul class="mt-6 grid grid-cols-3 gap-x-3 gap-y-5 md:grid-cols-6">
          {wall.map(({ brand, photo }) => (
            <li>
              <a href={`/brands/${brand.slug}`} class="group block no-underline">
                <img src={photo} alt="" width="300" height="375" loading="lazy" class="aspect-[4/5] w-full bg-soft object-cover" />
                <p class="mt-2 truncate text-sm font-medium text-ink group-hover:underline">{brand.name}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    lists.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 py-10">
        <div class="flex items-baseline justify-between gap-4">
          <h2 class="text-lg font-medium">Lists of alternatives</h2>
          <a href="/brands#lists" class="text-link text-sm">
            All {lists.length} lists
          </a>
        </div>
        <ul class="-mx-4 mt-4 flex snap-x gap-3 overflow-x-auto px-4 pb-2">
          {lists.map((l) => (
            <li class="w-60 shrink-0 snap-start">
              <a href={l.path} class="group flex h-full flex-col border border-rule p-4 no-underline hover:border-ink">
                <span class="eyebrow">{l.category}</span>
                <span class="mt-2 line-clamp-3 text-sm font-medium text-ink group-hover:underline">{l.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>
