---
import Base from "../layouts/Base.astro";

const CHECKS = [
  { title: "Live and selling", body: "Every brand on a list is checked against its own store. Closed or off-category brands drop out." },
  { title: "Real prices and sizes", body: "Regular prices come from each brand's own store, with sizes and where it ships. Every brand ships to the US." },
  { title: "Recommended elsewhere too", body: "A brand only makes a list if sources outside Stylodex also put it alongside the original." },
];
---

<Base
  description="Verified alternatives to fashion and beauty brands and stores, with real prices, sizes and shipping for each."
  canonical="/"
>
  <section class="mx-auto max-w-6xl px-4 pb-16 pt-14 md:pt-20">
    <h1 class="max-w-2xl text-4xl font-normal leading-[1.1] tracking-tight md:text-5xl">
      Find brands like the ones you already love
    </h1>
    <p class="mt-6 max-w-xl text-lg leading-relaxed">
      Verified alternatives to the brands and stores you know, with real prices, sizes and shipping for each one.
    </p>
  </section>
  <section class="border-t border-rule">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <h2 class="font-serif text-3xl">How every list is checked</h2>
      <div class="mt-8 grid gap-8 md:grid-cols-3">
        {
          CHECKS.map((c, i) => (
            <div class:list={["p-6", ["bg-butter", "bg-mint", "bg-sky"][i % 3]]}>
              <h3 class="font-medium">{c.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{c.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Base>
