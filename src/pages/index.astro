---
import HubTile from "../components/HubTile.astro";
import StoreCard from "../components/StoreCard.astro";
import Base from "../layouts/Base.astro";
import { categoryHubs, fitHubs } from "@/lib/categories";
import { loadCatalog } from "@/lib/catalog";
import { money } from "@/lib/format";
import { hubProducts, storeCards, tilePhotos } from "@/lib/home";

const { lists, brands } = await loadCatalog();
const categories = categoryHubs(brands).flatMap((g) => g.hubs);
const fits = fitHubs(brands);
const photos = tilePhotos([...categories, ...fits]);
const biggest = [...categories].sort((a, b) => b.brands.length - a.brands.length);
// Round shortcuts under the title: the biggest categories, then the fits.
const quick = [...biggest.slice(0, 7), ...fits];
// Store cards: the brands people search for (those with a list), biggest lists first.
const featured = [...lists].sort((a, b) => b.picks - a.picks).map((l) => l.anchorSlug);
const stores = storeCards(brands, featured, 12);
// A row of products for each of the three biggest categories.
const rows = biggest.slice(0, 3).map((hub) => ({ hub, products: hubProducts(hub, 12) }));
---

<Base
  description="Find brands like the ones you already love. Browse fashion brands and stores by category and size, with real prices, sizes and shipping for each."
  canonical="/"
>
  <section class="mx-auto max-w-6xl px-4 pb-6 pt-10 md:pt-14">
    <h1 class="max-w-3xl text-4xl leading-[1.05] md:text-6xl">Find brands like the ones you already love</h1>
    <p class="mt-4 max-w-xl text-lg leading-relaxed text-muted">
      Browse by what you shop for, or search any brand or store. Real prices, sizes and shipping for each one.
    </p>
    {
      quick.length > 0 && (
        <ul class="row mt-8">
          {quick.map((h) => {
            const photo = photos.get(h.path);
            return (
              <li class="shrink-0 snap-start">
                <a
                  href={h.path}
                  class="flex items-center gap-2 rounded-full bg-paper py-1.5 pl-1.5 pr-4 text-sm font-medium text-ink no-underline ring-1 ring-rule hover:ring-ink"
                >
                  {photo ? (
                    <img src={photo} alt="" width="64" height="64" class="h-8 w-8 rounded-full bg-soft object-cover" />
                  ) : (
                    <span class="h-8 w-8 rounded-full bg-soft" />
                  )}
                  {h.name}
                </a>
              </li>
            );
          })}
        </ul>
      )
    }
  </section>

  {
    stores.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 py-8">
        <div class="flex items-baseline justify-between gap-4">
          <h2 class="title text-2xl md:text-3xl">Brands and stores</h2>
          <a href="/brands" class="text-sm font-medium text-ink no-underline hover:underline">
            All {brands.length} <span aria-hidden="true">→</span>
          </a>
        </div>
        <ul class="row mt-5">
          {stores.map((s) => (
            <StoreCard {...s} />
          ))}
        </ul>
      </section>
    )
  }

  {
    categories.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 py-8">
        <h2 class="title text-2xl md:text-3xl">Categories</h2>
        <ul class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-6">
          {categories.map((hub) => (
            <HubTile hub={hub} photo={photos.get(hub.path) ?? null} />
          ))}
        </ul>
      </section>
    )
  }

  {
    fits.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 py-8">
        <h2 class="title text-2xl md:text-3xl">Sizes</h2>
        <ul class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-6">
          {fits.map((hub) => (
            <HubTile hub={hub} photo={photos.get(hub.path) ?? null} />
          ))}
        </ul>
      </section>
    )
  }

  {
    rows.map(
      ({ hub, products }) =>
        products.length > 0 && (
          <section class="mx-auto max-w-6xl px-4 py-8">
            <a href={hub.path} class="group inline-flex items-baseline gap-2 text-ink no-underline">
              <h2 class="title text-2xl group-hover:underline md:text-3xl">{hub.name}</h2>
              <span aria-hidden="true">→</span>
            </a>
            <ul class="row mt-5">
              {products.map(({ brand, shot }) => (
                <li class="w-40 shrink-0 snap-start sm:w-48">
                  <a href={`/brands/${brand.slug}`} class="group block no-underline">
                    <img
                      src={shot.imageUrl}
                      alt={shot.title}
                      width="400"
                      height="400"
                      loading="lazy"
                      class="aspect-square w-full rounded-2xl bg-paper object-cover transition-opacity group-hover:opacity-90"
                    />
                    <span class="mt-2 block truncate text-xs text-muted">{brand.name}</span>
                    <span class="block truncate text-sm font-medium text-ink group-hover:underline">{shot.title}</span>
                    <span class="block text-sm text-ink">{money(shot.price, shot.currency)}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ),
    )
  }

  {
    lists.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 py-8">
        <div class="flex items-baseline justify-between gap-4">
          <h2 class="text-lg font-semibold text-ink">Lists of alternatives</h2>
          <a href="/brands#lists" class="text-sm font-medium text-ink no-underline hover:underline">
            All {lists.length} <span aria-hidden="true">→</span>
          </a>
        </div>
        <ul class="row mt-4">
          {lists.map((l) => (
            <li class="w-60 shrink-0 snap-start">
              <a href={l.path} class="card group flex h-full flex-col p-4 no-underline ring-1 ring-rule hover:ring-ink">
                <span class="eyebrow">{l.category}</span>
                <span class="mt-2 line-clamp-3 text-sm font-medium text-ink group-hover:underline">{l.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>
