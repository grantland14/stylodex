---
import Base from "../../layouts/Base.astro";
import { loadCatalog } from "@/lib/catalog";

const { lists, brands } = await loadCatalog();
const groups = new Map<string, typeof brands>();
for (const b of brands) {
  const letter = /^[a-z]/i.test(b.name) ? b.name[0].toUpperCase() : "#";
  groups.set(letter, [...(groups.get(letter) ?? []), b]);
}
---

<Base title="All brands" description="Every brand and store on Stylodex, A to Z, and every list of alternatives." canonical="/brands">
  <section class="mx-auto max-w-5xl px-4 py-12">
    <p class="eyebrow text-accent">Directory</p>
    <h1 class="mt-3 text-4xl font-normal tracking-tight">All brands</h1>

    {
      lists.length > 0 && (
        <div class="mt-10">
          <h2 class="font-serif text-2xl">Lists of alternatives</h2>
          <ul class="mt-4 grid gap-x-8 sm:grid-cols-2">
            {lists.map((l) => (
              <li class="border-b border-rule">
                <a href={l.path} class="flex items-center justify-between py-3 text-ink no-underline hover:underline">
                  {l.title}
                  <span aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <div class="mt-12">
      <h2 class="font-serif text-2xl">Brands A–Z</h2>
      <nav class="mt-4 flex flex-wrap gap-2" aria-label="Jump to letter">
        {[...groups.keys()].map((letter) => <a href={`#letter-${letter}`} class="chip bg-soft no-underline">{letter}</a>)}
      </nav>
      {
        [...groups.entries()].map(([letter, items]) => (
          <section id={`letter-${letter}`} class="mt-8 scroll-mt-6">
            <h3 class="border-b border-ink pb-2 text-lg font-medium">{letter}</h3>
            <ul class="mt-2 grid gap-x-8 sm:grid-cols-2 md:grid-cols-3">
              {items.map((b) => (
                <li>
                  <a href={`/brands/${b.slug}`} class="block py-2 text-ink no-underline hover:underline">
                    {b.name}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>
</Base>
