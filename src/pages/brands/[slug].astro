---
import type { GetStaticPaths } from "astro";
import ArrowUpRight from "../../components/ArrowUpRight.astro";
import Base from "../../layouts/Base.astro";
import { listAlternativesPages, listProfileBrands } from "@/lib/data";
import { priceRange, shipsTo, sizes, usd } from "@/lib/format";
import { judgeBrandsLikePage, missingBrandFacts } from "@/lib/gate";
import { alternativesPath } from "@/lib/paths";
import type { Brand } from "@/lib/types";

export const getStaticPaths = (async () => {
  // Link only to alternatives pages this build actually generates, never to a 404.
  const built = new Map(
    (await listAlternativesPages())
      .filter((page) => judgeBrandsLikePage(page).picks.length > 0)
      .map((page) => [page.anchor.slug, alternativesPath(page.urlPrefix, page.anchor.slug)]),
  );
  return (await listProfileBrands()).map((brand) => ({
    params: { slug: brand.slug },
    props: { brand, alternatives: built.get(brand.slug) ?? null },
  }));
}) satisfies GetStaticPaths;

interface Props {
  brand: Brand;
  alternatives: string | null;
}

const { brand, alternatives } = Astro.props;
const path = `/brands/${brand.slug}`;
const goHref = `/go/${brand.slug}?from=${encodeURIComponent(path)}`;
const host = brand.websiteUrl ? new URL(brand.websiteUrl).hostname.replace(/^www\./, "") : null;
// Indexable once the brand passes the fact check for at least one category it sells.
const indexable = brand.prices.some((p) => missingBrandFacts(brand, p.category).length === 0);

const facts: [string, string | null][] = [
  ...brand.prices.map((p): [string, string | null] => [p.category[0].toUpperCase() + p.category.slice(1), priceRange(p)]),
  ["Sizes", sizes(brand)],
  ["Ships to", shipsTo(brand)],
  ["Free shipping", brand.freeShippingMinUsd != null ? `Over ${usd(brand.freeShippingMinUsd)}` : null],
  ["Returns", brand.returnsDays != null ? `${brand.returnsDays} days` : null],
  ["Based in", brand.hqCountry],
  ["Founded", brand.foundedYear?.toString() ?? null],
  ["Materials", brand.materials.join(", ") || null],
  ["Certifications", brand.certifications.join(", ") || null],
  ["How it's made", brand.productionModel],
  ["Sales", brand.salePattern],
];
---

<Base
  title={`${brand.name}: Prices, Sizes, Shipping and Returns`}
  description={`${brand.name} at a glance: what it costs by category, the sizes it makes, where it ships and its returns policy.`}
  canonical={path}
  index={indexable}
>
  <article class="mx-auto max-w-3xl px-4 py-10 md:py-14">
    <div class="md:grid md:grid-cols-[16rem_1fr] md:gap-10">
      {
        brand.imageUrl && (
          <img src={brand.imageUrl} alt={brand.name} width="512" height="512" class="aspect-square w-full bg-soft object-cover" />
        )
      }
      <div class="mt-6 md:mt-0">
        <p class="eyebrow">Brand</p>
        <h1 class="mt-2 text-4xl font-normal tracking-tight">{brand.name}</h1>
        {brand.knownFor && <p class="mt-3 text-lg leading-relaxed">Known for {brand.knownFor.toLowerCase()}.</p>}
        {
          host && (
            <a href={goHref} rel="sponsored nofollow" class="mt-3 inline-flex items-center gap-1 text-sm text-ink underline">
              {host} <ArrowUpRight />
            </a>
          )
        }
        <div class="mt-6 grid grid-cols-2 gap-3 sm:flex">
          {
            alternatives && (
              <a href={alternatives} class="btn-line">
                Alternatives to {brand.name}
              </a>
            )
          }
          <a href={goHref} rel="sponsored nofollow" class="btn-solid">Shop <ArrowUpRight /></a>
        </div>
      </div>
    </div>

    <nav class="mt-12 flex gap-8 border-b border-rule text-sm" aria-label="Sections">
      <span class="-mb-px border-b-2 border-ink pb-3 font-medium text-ink">Overview</span>
      {
        alternatives && (
          <a href={alternatives} class="pb-3 text-muted no-underline hover:text-ink">
            Alternatives
          </a>
        )
      }
    </nav>

    <dl class="mt-2 text-sm">
      {
        facts
          .filter(([, value]) => value)
          .map(([label, value]) => (
            <div class="grid grid-cols-3 gap-4 border-b border-rule py-3">
              <dt class="text-muted">{label}</dt>
              <dd class="col-span-2 text-ink">{value}</dd>
            </div>
          ))
      }
    </dl>
  </article>
</Base>
