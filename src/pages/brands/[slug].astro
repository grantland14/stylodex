---
// Brand profile: what a brand sells, what it costs, its sizes, shipping, returns and
// background, all from its own store, plus every list it appears on.
import type { GetStaticPaths } from "astro";
import ArrowUpRight from "../../components/ArrowUpRight.astro";
import ProductStrip from "../../components/ProductStrip.astro";
import Base from "../../layouts/Base.astro";
import { listAlternativesPages, listProfileBrands } from "@/lib/data";
import { countryName, longDate, priceWithUsd, shipsTo, sizes, usd } from "@/lib/format";
import { brandsLikeTitle, judgeBrandsLikePage, missingBrandFacts } from "@/lib/gate";
import { alternativesPath } from "@/lib/paths";
import type { Brand } from "@/lib/types";

interface Listing {
  path: string;
  title: string;
}

export const getStaticPaths = (async () => {
  const pages = (await listAlternativesPages())
    .map((page) => ({ page, verdict: judgeBrandsLikePage(page) }))
    .filter(({ verdict }) => verdict.picks.length > 0);
  // Link only to pages this build actually generates, never to a 404.
  const alternatives = new Map(pages.map(({ page }) => [page.anchor.slug, alternativesPath(page.urlPrefix, page.anchor.slug)]));
  const listedOn = new Map<string, Listing[]>();
  for (const { page, verdict } of pages) {
    const listing = { path: alternativesPath(page.urlPrefix, page.anchor.slug), title: brandsLikeTitle(page, verdict.picks.length) };
    for (const pick of verdict.picks) listedOn.set(pick.brand.slug, [...(listedOn.get(pick.brand.slug) ?? []), listing]);
  }
  return (await listProfileBrands()).map((brand) => ({
    params: { slug: brand.slug },
    props: { brand, alternatives: alternatives.get(brand.slug) ?? null, listedOn: listedOn.get(brand.slug) ?? [] },
  }));
}) satisfies GetStaticPaths;

interface Props {
  brand: Brand;
  alternatives: string | null;
  listedOn: Listing[];
}

const { brand, alternatives, listedOn } = Astro.props;
const path = `/brands/${brand.slug}`;
const goHref = `/go/${brand.slug}?from=${encodeURIComponent(path)}`;
const host = brand.websiteUrl ? new URL(brand.websiteUrl).hostname.replace(/^www\./, "") : null;
// Indexable once the brand passes the fact check for at least one category it sells.
const indexable = brand.prices.some((p) => missingBrandFacts(brand, p.category).length === 0);
const label = (category: string) => category.replace(/-/g, " ").replace(/^\w/, (c) => c.toUpperCase());
const yesNo = (v: boolean | null) => (v == null ? null : v ? "Yes" : "No");
const lastChecked = [brand.verifiedAt, ...brand.prices.map((p) => p.checkedAt)].filter(Boolean).sort().at(-1) ?? null;

type Row = [string, string | null];
const allGroups: { title: string; rows: Row[] }[] = [
  { title: "Prices", rows: brand.prices.map((p): Row => [label(p.category), priceWithUsd(p)]) },
  {
    title: "Sizing",
    rows: [
      ["Sizes", sizes(brand)],
      ["Plus sizes", yesNo(brand.hasPlus)],
      ["Petite", yesNo(brand.hasPetite)],
      ["Tall", yesNo(brand.hasTall)],
    ],
  },
  {
    title: "Shipping and returns",
    rows: [
      ["Ships to", shipsTo(brand)],
      ["Free US shipping", brand.freeShippingMinUsd != null ? `Over ${usd(brand.freeShippingMinUsd)}` : null],
      ["Returns", brand.returnsDays != null ? `${brand.returnsDays} days` : null],
    ],
  },
  {
    title: "About",
    rows: [
      ["Based in", countryName(brand.hqCountry)],
      ["Founded", brand.foundedYear?.toString() ?? null],
      ["Owned by", brand.parentCompany],
      ["Materials", brand.materials.join(", ") || null],
      ["Certifications", brand.certifications.join(", ") || null],
      ["How it's made", brand.productionModel],
      ["Sales", brand.salePattern],
    ],
  },
];
const groups = allGroups.map((g) => ({ ...g, rows: g.rows.filter(([, v]) => v) })).filter((g) => g.rows.length > 0);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Brand",
  name: brand.name,
  url: brand.websiteUrl ?? undefined,
  image: brand.imageUrl ? new URL(brand.imageUrl, Astro.site).href : undefined,
  description: brand.knownFor ?? undefined,
};
---

<Base
  title={`${brand.name}: Prices, Sizes, Shipping and Returns`}
  description={`${brand.name} at a glance: what it costs by category, the sizes it makes, where it ships and its returns policy, checked on its own store.`}
  canonical={path}
  index={indexable}
  jsonLd={jsonLd}
>
  <article class="mx-auto max-w-3xl px-4 py-10 md:py-14">
    <header class:list={[brand.imageUrl && "md:grid md:grid-cols-[1fr_14rem] md:items-start md:gap-10"]}>
      <div>
        <p class="eyebrow">{brand.kind === "retailer" ? "Store" : "Brand"}</p>
        <h1 class="mt-2 text-4xl font-normal tracking-tight md:text-5xl">{brand.name}</h1>
        {brand.knownFor && <p class="mt-3 text-lg leading-relaxed">Known for {brand.knownFor.toLowerCase()}.</p>}
        {
          host && (
            <a href={goHref} rel="sponsored nofollow" class="mt-3 inline-flex items-center gap-1 text-sm text-ink underline">
              {host} <ArrowUpRight />
            </a>
          )
        }
        <div class="mt-6 grid grid-cols-2 gap-3 sm:flex">
          <a href={goHref} rel="sponsored nofollow" class="btn-solid">Shop {brand.name} <ArrowUpRight /></a>
          {
            alternatives && (
              <a href={alternatives} class="btn-line">
                Brands like {brand.name}
              </a>
            )
          }
        </div>
      </div>
      {
        brand.imageUrl && (
          <img
            src={brand.imageUrl}
            alt={`${brand.name}`}
            width="448"
            height="448"
            class="mt-8 aspect-square w-full bg-soft object-contain md:mt-0"
          />
        )
      }
    </header>

    {brand.about && <p class="mt-10 max-w-2xl text-lg leading-relaxed">{brand.about}</p>}

    {
      brand.productShots.length > 0 && (
        <section class="mt-12" aria-labelledby="from-the-store">
          <h2 id="from-the-store" class="eyebrow">
            From {brand.name}'s store
          </h2>
          <div class="mt-4">
            <ProductStrip brandSlug={brand.slug} brandName={brand.name} shots={brand.productShots} from={path} max={6} />
          </div>
        </section>
      )
    }

    <div class="mt-12 grid gap-x-10 gap-y-10 md:grid-cols-2">
      {
        groups.map((g) => (
          <section>
            <h2 class="border-b border-ink pb-2 font-serif text-2xl">{g.title}</h2>
            <dl class="text-sm">
              {g.rows.map(([k, v]) => (
                <div class="grid grid-cols-[8rem_1fr] gap-4 border-b border-rule py-3">
                  <dt class="text-muted">{k}</dt>
                  <dd class="text-ink">{v}</dd>
                </div>
              ))}
            </dl>
          </section>
        ))
      }
    </div>

    {
      listedOn.length > 0 && (
        <section class="mt-14" aria-labelledby="listed-on">
          <h2 id="listed-on" class="font-serif text-2xl">
            Where {brand.name} is recommended
          </h2>
          <ul class="mt-4 divide-y divide-rule border-y border-rule">
            {listedOn.map((l) => (
              <li>
                <a href={l.path} class="flex items-center justify-between py-3 text-ink no-underline hover:underline">
                  {l.title}
                  <span aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      lastChecked && (
        <p class="mt-12 text-xs text-muted">
          Checked against {host ?? `${brand.name}'s own store`} on {longDate(lastChecked)}. Prices are regular prices, not sale
          prices. <a href="/how-we-pick" class="underline">How we check</a>.
        </p>
      )
    }
  </article>
</Base>
